+                  {{ formatBytes(r.quota) }}
+                </span>
+              </div>
+              <div class="space-report-bar-track">
+                <div
+                  class="space-report-bar"
+                  :class="{ 'space-report-bar-warn': (r.ratio as number) >= threshold }"
