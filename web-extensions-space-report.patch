+import { computed } from 'vue'
+import type { RouteRecordRaw } from 'vue-router'
+import { useGettext } from 'vue3-gettext'
+import { Ability } from '@ownclouders/web-client'
+import {
+  AppMenuItemExtension,
+  ApplicationInformation,
+  defineWebApplication,
+  useAbility,
+  useAuthService,
+  useUserStore
+} from '@ownclouders/web-pkg'
+import ReportView from './views/ReportView.vue'
+import { useCapabilityStore } from './compat'
+import { applyReportConfig } from './config'
+import { APP_ID, canView } from './constants'
+import translations from '../l10n/translations.json'
+
+// NOTE: only a default export here — Web loads the AMD bundle and uses the module value itself.
+
+export default defineWebApplication({
+  setup({ applicationConfig }) {
+    const { $gettext } = useGettext()
+    const ability = useAbility()
+    const userStore = useUserStore()
+    applyReportConfig(applicationConfig)
+
+    const appInfo: ApplicationInformation = {
+      name: $gettext('Space report'),
+      id: APP_ID,
+      icon: 'pie-chart-2',
+      color: '#2b2b2b'
+    }
+
+    // globalProperties carry $ability (CASL)
+    const routes = ({ $ability }: any): RouteRecordRaw[] => [
+      {
+        path: '/',
+        name: 'report',
+        component: ReportView,
+        beforeEnter: async (to) => {
+          if (!canView($ability as Ability)) {
+            return { name: 'accessDenied' }
+          }
+          // same as Admin Settings; also gives the token the ACR needed to list Vault spaces
+          const capabilityStore = useCapabilityStore()
+          if (capabilityStore.authMfaEnabled) {
+            await useAuthService().requireAcr(capabilityStore.authMfaRequiredLevelname, to.fullPath)
+          }
+          return true
+        },
+        meta: {
+          authContext: 'user',
+          title: $gettext('Space report')
+        }
+      }
+    ]
+
+    const menuItems = computed<AppMenuItemExtension[]>(() => {
+      if (!userStore.user || !canView(ability)) return []
+      return [
+        {
+          id: `app.${APP_ID}.menuItem`,
+          type: 'appMenuItem',
+          label: () => appInfo.name,
+          color: appInfo.color,
+          icon: appInfo.icon,
+          priority: 46,
+          path: APP_ID
+        }
+      ]
+    })
+
+    return { appInfo, routes, translations, extensions: menuItems }
+  }
+})
diff --git a/packages/web-app-space-report/src/orphans.ts b/packages/web-app-space-report/src/orphans.ts
new file mode 100644
index 0000000..8906ea3
--- /dev/null
+++ b/packages/web-app-space-report/src/orphans.ts
@@ -0,0 +1,164 @@
+// Orphaned spaces:
+//  - personal space whose owner no longer exists in the user backend      -> 'owner-missing'
+//  - project space without any member                                       -> 'no-members'
+//  - project space whose members all point to deleted users/groups
+//    or to groups without members                                           -> 'members-gone'
+// Extra flags (not orphaned, but worth a look):
+//  - ownerDisabled: personal space of a disabled account
+//  - noManager:     project space with live members but no live manager
+import { OrphanReason, SpaceRow } from './report'
+
+export interface DirectoryUser {
+  id: string
+  accountEnabled?: boolean
+}
+
+export interface DirectoryGroup {
+  id: string
+  /** undefined: member list unknown (not expanded) */
+  memberCount?: number
+}
+
+export interface Lookups {
+  /** single lookup by id; resolves false only on 404 */
+  userExists(id: string): Promise<boolean>
+  groupExists(id: string): Promise<boolean>
+}
+
+export interface OrphanResult {
+  rows: SpaceRow[]
+  /** ids that could not be verified (lookup error or limit reached) — never counted as orphaned */
+  unverified: number
+}
+
+export interface OrphanSummary {
+  personalOwnerMissing: number
+  projectNoMembers: number
+  projectMembersGone: number
+  total: number
+  /** storage held by orphaned spaces */
+  used: number
+  ownerDisabled: number
+  noManager: number
+}
+
+/** Runs fn over items with limited concurrency. */
+async function pool<T>(items: T[], limit: number, fn: (item: T) => Promise<void>) {
+  let i = 0
+  const workers = Array.from({ length: Math.min(limit, items.length) }, async () => {
+    while (i < items.length) await fn(items[i++])
+  })
+  await Promise.all(workers)
+}
+
+/**
+ * The directory listings are only a first pass: oCIS reads users/groups without paging, so an
+ * LDAP size limit can truncate them. Every id missing from a listing is confirmed with a direct
+ * lookup before a space is reported as orphaned.
+ */
+export async function analyzeOrphans({
+  rows,
+  users,
+  groups,
+  lookups,
+  maxLookups = 500,
+  concurrency = 8
+}: {
+  rows: SpaceRow[]
+  users: DirectoryUser[]
+  groups: DirectoryGroup[] | null
+  lookups: Lookups
+  maxLookups?: number
+  concurrency?: number
+}): Promise<OrphanResult> {
+  const userById = new Map(users.map((u) => [u.id, u]))
+  const groupById = new Map((groups || []).map((g) => [g.id, g]))
+
+  // ids not in the listings, to be confirmed one by one
+  const unknownUsers = new Set<string>()
+  const unknownGroups = new Set<string>()
+  for (const r of rows) {
+    if (r.kind.endsWith('personal')) {
+      if (r.ownerId && !userById.has(r.ownerId)) unknownUsers.add(r.ownerId)
+    } else {
+      for (const m of r.members) {
+        if (m.type === 'user' && !userById.has(m.id)) unknownUsers.add(m.id)
+        if (m.type === 'group' && groups && !groupById.has(m.id)) unknownGroups.add(m.id)
+      }
+    }
+  }
+
+  // id -> true (exists) | false (gone) | undefined (not verified)
+  const userState = new Map<string, boolean | undefined>()
+  const groupState = new Map<string, boolean | undefined>()
+  const jobs: Array<() => Promise<void>> = [
+    ...[...unknownUsers].map((id) => async () => {
+      userState.set(id, await lookups.userExists(id).catch(() => undefined))
+    }),
+    ...[...unknownGroups].map((id) => async () => {
+      groupState.set(id, await lookups.groupExists(id).catch(() => undefined))
+    })
+  ]
+  await pool(jobs.slice(0, maxLookups), concurrency, (job) => job())
+  const unverified =
+    Math.max(0, jobs.length - maxLookups) +
+    [...userState.values(), ...groupState.values()].filter((v) => v === undefined).length
+
+  const userAlive = (id: string): boolean | undefined =>
+    userById.has(id) ? true : userState.get(id)
+  const groupAlive = (id: string): boolean | undefined => {
+    if (!groups) return undefined // group listing not available: can't judge
+    const g = groupById.get(id)
+    if (g) return g.memberCount === undefined ? true : g.memberCount > 0
+    return groupState.get(id) // exists-but-unlisted counts as alive (member count unknown)
+  }
+
+  const out = rows.map((r): SpaceRow => {
+    const row: SpaceRow = { ...r, orphan: null, ownerDisabled: false, noManager: false }
+    if (r.kind.endsWith('personal')) {
+      if (!r.ownerId) {
+        row.orphan = 'owner-missing'
+      } else {
+        if (userAlive(r.ownerId) === false) row.orphan = 'owner-missing'
+        row.ownerDisabled = userById.get(r.ownerId)?.accountEnabled === false
+      }
+      return row
+    }
+
+    if (!r.members.length) {
+      row.orphan = 'no-members'
+      return row
+    }
+    const states = r.members.map((m) => (m.type === 'user' ? userAlive(m.id) : groupAlive(m.id)))
+    if (states.every((s) => s === false)) {
+      row.orphan = 'members-gone'
+    } else {
+      // only flag a missing manager when we know the state of every manager grant
+      const managers = r.members.map((m, i) => ({ m, s: states[i] })).filter(({ m }) => m.manager)
+      row.noManager = managers.every(({ s }) => s === false)
+    }
+    return row
+  })
+
+  return { rows: out, unverified }
+}
+
+export function summarizeOrphans(rows: SpaceRow[]): OrphanSummary {
+  const count = (reason: OrphanReason) => rows.filter((r) => r.orphan === reason).length
+  const orphans = rows.filter((r) => r.orphan)
+  return {
+    personalOwnerMissing: count('owner-missing'),
+    projectNoMembers: count('no-members'),
+    projectMembersGone: count('members-gone'),
+    total: orphans.length,
+    used: orphans.reduce((a, r) => a + r.used, 0),
+    ownerDisabled: rows.filter((r) => r.ownerDisabled).length,
+    noManager: rows.filter((r) => r.noManager).length
+  }
+}
+
+export const ORPHAN_LABEL: Record<OrphanReason, string> = {
+  'owner-missing': 'Owner no longer exists',
+  'no-members': 'No members',
+  'members-gone': 'All members deleted/empty'
+}
diff --git a/packages/web-app-space-report/src/pdf.ts b/packages/web-app-space-report/src/pdf.ts
new file mode 100644
index 0000000..9eef423
--- /dev/null
+++ b/packages/web-app-space-report/src/pdf.ts
@@ -0,0 +1,186 @@
+import { jsPDF } from 'jspdf'
+import { autoTable } from 'jspdf-autotable'
+import { ReportData, dateTime, isoDate, sections } from './export'
+
+// ---- PDF ----------------------------------------------------------------------------------
+
+/** Helvetica only covers Latin-1 (WinAnsi); replace what it can't draw instead of printing garbage. */
+const pdfSafe = (s: string) =>
+  s
+    .replace(/[–—]/g, '-')
+    .replace(/≥/g, '>=')
+    .replace(/[^\x20-\x7e\xa0-\xff€]/g, '?')
+
+const ACCENT: [number, number, number] = [43, 43, 43]
+
+export function buildPdf(data: ReportData): Blob {
+  const { meta } = data
+  const s = sections(data)
+  const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' })
+  const pageW = doc.internal.pageSize.getWidth()
+  const margin = 14
+  let y = margin
+
+  const safeRows = (rows: string[][]) => rows.map((r) => r.map(pdfSafe))
+  const tableDefaults = {
+    margin: { left: margin, right: margin },
+    styles: { fontSize: 8.5, cellPadding: 1.6, overflow: 'linebreak' as const },
+    headStyles: { fillColor: ACCENT, textColor: 255, fontStyle: 'bold' as const },
+    alternateRowStyles: { fillColor: [245, 245, 245] as [number, number, number] }
+  }
+  // header cells follow their column's alignment (autoTable applies columnStyles to the body only)
+  const alignHead = (c: any) => {
+    if (c.section !== 'head') return
+    const halign = c.table.styles?.columnStyles?.[c.column.index]?.halign
+    if (halign) c.cell.styles.halign = halign
+  }
+  const withHead = (fn?: (c: any) => void) => (c: any) => {
+    alignHead(c)
+    fn?.(c)
+  }
+  const nextY = () => ((doc as any).lastAutoTable?.finalY ?? y) + 8
+  const heading = (text: string) => {
+    if (y > doc.internal.pageSize.getHeight() - 40) {
+      doc.addPage()
+      y = margin
+    }
+    doc.setFont('helvetica', 'bold').setFontSize(12).text(pdfSafe(text), margin, y)
+    y += 3
+  }
+
+  // title
+  doc
+    .setFont('helvetica', 'bold')
+    .setFontSize(18)
+    .text('Space report', margin, y + 4)
+  doc.setFont('helvetica', 'normal').setFontSize(10)
+  doc.text(pdfSafe(meta.server), margin, y + 11)
+  doc.setTextColor(110)
+  doc.text(
+    pdfSafe(`Generated ${dateTime(meta.generatedAt)} by ${meta.generatedBy || 'unknown'}`),
+    margin,
+    y + 16
+  )
+  doc.setTextColor(0)
+  y += 24
+
+  // notes
+  doc.setFontSize(8.5).setTextColor(90)
+  for (const n of s.notes) {
+    const lines = doc.splitTextToSize(pdfSafe(`- ${n}`), pageW - 2 * margin)
+    doc.text(lines, margin, y)
+    y += lines.length * 3.8
+  }
+  doc.setTextColor(0)
+  y += 4
+
+  // overview + key figures side by side
+  heading('Overview')
+  const [ovHeader, ...ovRows] = s.overview
+  const half = (pageW - 2 * margin - 6) / 2
+  autoTable(doc, {
+    ...tableDefaults,
+    startY: y,
+    head: [ovHeader.map(pdfSafe)],
+    body: safeRows(ovRows),
+    tableWidth: half + 16,
+    columnStyles: { 1: { halign: 'right' }, 2: { halign: 'right' }, 3: { halign: 'right' } },
+    didParseCell: withHead((c) => {
+      if (c.section === 'body' && c.row.index === ovRows.length - 1)
+        c.cell.styles.fontStyle = 'bold'
+    })
+  })
+  const overviewEnd = nextY()
+  autoTable(doc, {
+    ...tableDefaults,
+    startY: y,
+    margin: { left: margin + half + 22, right: margin },
+    head: [['Key figure', 'Value']],
+    body: safeRows(s.keyFigures),
+    columnStyles: { 1: { halign: 'right' } },
+    didParseCell: withHead()
+  })
+  y = Math.max(overviewEnd, nextY())
+
+  heading('Largest spaces')
+  autoTable(doc, {
+    ...tableDefaults,
+    startY: y,
+    head: [['#', 'Space', 'Type', 'Used']],
+    body: s.largest.length ? safeRows(s.largest) : [['', 'No data', '', '']],
+    columnStyles: { 0: { halign: 'right', cellWidth: 8 }, 3: { halign: 'right' } },
+    didParseCell: withHead()
+  })
+  y = nextY()
+
+  heading('Fullest spaces (by quota)')
+  autoTable(doc, {
+    ...tableDefaults,
+    startY: y,
+    head: [['#', 'Space', 'Type', 'Full', 'Used / Quota']],
+    body: s.fullest.length ? safeRows(s.fullest) : [['', 'No spaces with a quota', '', '', '']],
+    columnStyles: {
+      0: { halign: 'right', cellWidth: 8 },
+      3: { halign: 'right' },
+      4: { halign: 'right' }
+    },
+    didParseCell: withHead((c) => {
+      const ratio = data.summary.fullest[c.row.index]?.ratio
+      if (
+        c.section === 'body' &&
+        c.column.index === 3 &&
+        ratio !== null &&
+        ratio !== undefined &&
+        ratio * 100 >= meta.thresholdPercent
+      ) {
+        c.cell.styles.textColor = [198, 40, 40]
+        c.cell.styles.fontStyle = 'bold'
+      }
+    })
+  })
+  y = nextY()
+
+  if (s.orphanCheck) {
+    heading(`Orphaned spaces (${s.orphans.length})`)
+    autoTable(doc, {
+      ...tableDefaults,
+      startY: y,
+      head: [['Type', 'Space', 'Reason', 'Used', 'Modified']],
+      body: s.orphans.length ? safeRows(s.orphans) : [['', 'No orphaned spaces found', '', '', '']],
+      columnStyles: { 3: { halign: 'right' }, 4: { halign: 'right', cellWidth: 20 } },
+      didParseCell: withHead()
+    })
+    y = nextY()
+  }
+
+  doc.addPage()
+  y = margin
+  heading(`All spaces (${s.all.length})`)
+  autoTable(doc, {
+    ...tableDefaults,
+    startY: y,
+    head: [['Type', 'Name', 'Owner', 'Used', 'Quota', 'Full', 'Modified']],
+    body: safeRows(s.all),
+    styles: { ...tableDefaults.styles, fontSize: 7.5 },
+    columnStyles: {
+      0: { cellWidth: 22 },
+      3: { halign: 'right' },
+      4: { halign: 'right' },
+      5: { halign: 'right' },
+      6: { halign: 'right', cellWidth: 20 }
+    },
+    didParseCell: withHead()
+  })
+
+  // footer on every page
+  const pages = doc.getNumberOfPages()
+  for (let i = 1; i <= pages; i++) {
+    doc.setPage(i)
+    doc.setFont('helvetica', 'normal').setFontSize(7.5).setTextColor(130)
+    const h = doc.internal.pageSize.getHeight()
+    doc.text(pdfSafe(`${meta.server} - ${isoDate(meta.generatedAt)}`), margin, h - 8)
+    doc.text(`${i} / ${pages}`, pageW - margin, h - 8, { align: 'right' })
+  }
+
+  return doc.output('blob')
+}
